#. module: di_stock_replenish
#. odoo-python
#: code:addons/di_stock_replenish/models/stock_replenish.py:0
msgid ""
"%(name)s has transfers that are not cancelled: %(pickings)s. Cancel those in "
"Inventory first - or, if one is already validated, reverse it with a "
"transfer of its own so the movement stays traceable."
msgstr ""
"%(name)s ha trasferimenti non annullati: %(pickings)s. Annullali prima in "
"Magazzino - oppure, se uno è già validato, stornalo con un trasferimento "
"apposito così il movimento resta tracciabile."

#. module: di_stock_replenish
#. odoo-python
#: code:addons/di_stock_replenish/models/stock_replenish.py:0
msgid "%(product)s: %(planned)s planned but only %(free)s free at %(source)s."
msgstr ""
"%(product)s: %(planned)s pianificati ma solo %(free)s disponibili a "
"%(source)s."

#. module: di_stock_replenish
#. odoo-python
#: code:addons/di_stock_replenish/models/stock_replenish.py:0
msgid ""
"%s has already generated transfers, so it cannot be deleted. Cancel it "
"instead."
msgstr ""
"%s ha già generato trasferimenti, quindi non può essere eliminato. Annullalo "
"invece."

#. module: di_stock_replenish
#. odoo-python
#: code:addons/di_stock_replenish/models/stock_replenish.py:0
