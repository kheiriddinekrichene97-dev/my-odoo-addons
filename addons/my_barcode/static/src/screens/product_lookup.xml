<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_barcode.ProductLookup">
        <div class="o_my_barcode_screen">
            <div t-if="!state.product" class="o_my_barcode_empty">
                <i class="fa fa-search d-block"/>
                Scan a product (or type its barcode / internal reference) to see its details.
            </div>
            <t t-else="">
                <t t-set="product" t-value="state.product"/>
                <div class="card mb-3">
                    <div class="card-body d-flex flex-wrap gap-3">
                        <img class="o_my_barcode_product_image rounded border" t-att-src="imageUrl" alt=""/>
                        <div class="flex-grow-1">
                            <h3 class="mb-1" t-esc="product.display_name"/>
                            <div class="text-muted mb-2">
                                <span t-if="product.default_code" class="me-3">
                                    <i class="fa fa-tag me-1"/><t t-esc="product.default_code"/>
                                </span>
                                <span t-if="product.barcode">
                                    <i class="fa fa-barcode me-1"/><t t-esc="product.barcode"/>
                                </span>
                                <span t-else="" class="text-warning">
                                    <i class="fa fa-exclamation-triangle me-1"/>No barcode
                                </span>
                            </div>
                            <div class="d-flex flex-wrap gap-4">
                                <div>
                                    <div class="small text-muted">Sales price</div>
                                    <div class="fs-4 fw-bold" t-esc="price"/>
                                </div>
                                <div t-if="product.is_storable">
                                    <div class="small text-muted">On hand</div>
                                    <div class="fs-4 fw-bold">
                                        <t t-esc="formatQty(product.qty_available)"/>
                                        <small class="fs-6 fw-normal" t-esc="product.uom"/>
                                    </div>
                                </div>
                                <div t-if="product.is_storable">
                                    <div class="small text-muted">Forecasted</div>
                                    <div class="fs-4">
                                        <t t-esc="formatQty(product.virtual_available)"/>
                                        <small class="fs-6" t-esc="product.uom"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <button class="btn btn-secondary" t-on-click="() => props.api.openRecord('product.product', product.id)">
                            <i class="fa fa-external-link me-1"/>Open product
                        </button>
                        <button t-if="!product.barcode" class="btn btn-secondary"
                                t-on-click="() => props.api.navigate('assign', { productId: product.id })">
                            <i class="fa fa-barcode me-1"/>Assign a barcode
                        </button>
                    </div>
                </div>

                <div t-if="product.is_storable" class="card">
                    <div class="card-header fw-bold">Stock by location</div>
                    <ul class="list-group list-group-flush">
                        <li t-foreach="product.locations" t-as="location" t-key="location.id"
                            class="list-group-item d-flex justify-content-between">
                            <span t-esc="location.name"/>
                            <span class="fw-bold">
                                <t t-esc="formatQty(location.quantity)"/> <t t-esc="product.uom"/>
                            </span>
                        </li>
                        <li t-if="!product.locations.length" class="list-group-item text-muted">
                            No stock in any location.
                        </li>
                    </ul>
                </div>
                <div t-else="" class="alert alert-info">
                    This product doesn't track inventory.
                </div>
            </t>
        </div>
    </t>

</templates>
