<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_barcode.PickingList">
        <div class="o_my_barcode_screen">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted">Scan a transfer reference or pick one below.</span>
                <button class="btn btn-light border" title="Refresh" aria-label="Refresh" t-on-click="load">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
            <div t-if="state.loaded and !state.pickings.length" class="o_my_barcode_empty">
                <i class="fa fa-check-circle d-block"/>
                No transfers are waiting to be processed.
            </div>
            <div t-else="" class="list-group">
                <a t-foreach="state.pickings" t-as="picking" t-key="picking.id" href="#"
                   class="list-group-item list-group-item-action d-flex flex-wrap gap-2 align-items-center"
                   t-on-click.prevent="() => this.open(picking.id)">
                    <div class="flex-grow-1">
                        <div class="fw-bold" t-esc="picking.name"/>
                        <div class="small text-muted">
                            <span t-if="picking.partner" class="me-3"><i class="fa fa-user me-1"/><t t-esc="picking.partner"/></span>
                            <span t-if="picking.origin" class="me-3"><i class="fa fa-file-text-o me-1"/><t t-esc="picking.origin"/></span>
                            <span><i class="fa fa-clock-o me-1"/><t t-esc="formatDate(picking.scheduled_date)"/></span>
                        </div>
                    </div>
                    <span class="badge rounded-pill"
                          t-att-class="picking.state === 'assigned' ? 'text-bg-success' : 'text-bg-warning'"
                          t-esc="picking.state_label"/>
                    <i class="fa fa-chevron-right text-muted"/>
                </a>
            </div>
        </div>
    </t>

</templates>
