<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_barcode.PickingDetail">
        <div class="o_my_barcode_screen" t-if="state.picking">
            <t t-set="picking" t-value="state.picking"/>
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h3 class="mb-0 me-auto" t-esc="picking.name"/>
                        <span class="badge rounded-pill text-bg-secondary" t-esc="picking.type_name"/>
                        <span class="badge rounded-pill"
                              t-att-class="picking.state === 'done' ? 'text-bg-success' : 'text-bg-info'"
                              t-esc="picking.state_label"/>
                    </div>
                    <div class="text-muted small">
                        <span t-if="picking.partner" class="me-3"><i class="fa fa-user me-1"/><t t-esc="picking.partner"/></span>
                        <span t-if="picking.origin" class="me-3"><i class="fa fa-file-text-o me-1"/><t t-esc="picking.origin"/></span>
                        <span><t t-esc="picking.location_src"/> <i class="fa fa-long-arrow-right mx-1"/> <t t-esc="picking.location_dest"/></span>
                    </div>
                    <div class="progress mt-3" role="progressbar" t-att-aria-valuenow="progress" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" t-att-class="progress === 100 ? 'bg-success' : ''"
                             t-attf-style="width: {{progress}}%;" t-esc="progress + '%'"/>
                    </div>
                </div>
            </div>

            <p t-if="picking.is_open" class="text-muted small">
                Scan each product. Lines turn green when complete and orange when more than expected was scanned.
            </p>

            <div class="list-group mb-3">
                <div t-foreach="picking.lines" t-as="line" t-key="line.move_id"
                     class="list-group-item o_my_barcode_line d-flex flex-wrap align-items-center gap-2"
                     t-att-class="{
                        o_my_barcode_line_done: lineStatus(line) === 'done',
                        o_my_barcode_line_over: lineStatus(line) === 'over',
                        o_my_barcode_line_last: line.move_id === state.lastMoveId,
                     }">
                    <div class="flex-grow-1">
                        <div class="fw-bold" t-esc="line.product_name"/>
                        <div class="small text-muted">
                            <span t-if="line.barcode" class="me-2"><i class="fa fa-barcode me-1"/><t t-esc="line.barcode"/></span>
                            <span t-else="" class="text-warning me-2"><i class="fa fa-exclamation-triangle me-1"/>No barcode</span>
                            <span t-if="line.tracking !== 'none'" class="text-danger">
                                <i class="fa fa-lock me-1"/>Tracked by lot/serial: process it from Inventory
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <t t-if="picking.is_open">
                            <button class="btn btn-light border" title="Remove one" aria-label="Remove one"
                                    t-on-click="() => this.setQty(line, line.scanned - 1)">
                                <i class="fa fa-minus"/>
                            </button>
                            <input type="number" min="0" step="any" class="form-control o_my_barcode_qty_input"
                                   t-att-value="line.scanned" t-on-change="(ev) => this.onQtyChange(line, ev)"/>
                            <button class="btn btn-light border" title="Add one" aria-label="Add one"
                                    t-on-click="() => this.setQty(line, line.scanned + 1)">
                                <i class="fa fa-plus"/>
                            </button>
                        </t>
                        <span t-else="" class="fw-bold" t-esc="formatQty(line.scanned)"/>
                        <span class="text-nowrap ms-1">
                            / <t t-esc="formatQty(line.demand)"/> <t t-esc="line.uom"/>
                        </span>
                    </div>
                </div>
            </div>

            <div class="o_my_barcode_footer d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary" t-on-click="() => api.openRecord('stock.picking', picking.id)">
                    <i class="fa fa-external-link me-1"/>Open in Inventory
                </button>
                <button t-if="picking.is_open" class="btn btn-primary" t-on-click="validate">
                    <i class="fa fa-check me-1"/>Validate
                </button>
            </div>
        </div>
    </t>

</templates>
