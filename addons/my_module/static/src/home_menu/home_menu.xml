<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_module.HomeMenu">
        <div class="o_action o_my_home_menu h-100 overflow-auto" t-att-style="backgroundStyle">
            <div class="o_my_home_menu_content">
                <div class="o_my_home_menu_brand">
                    <img t-if="company.hasLogo" class="o_my_home_menu_logo" t-att-src="logoUrl" t-att-alt="company.name"/>
                    <div t-else="" class="o_my_home_menu_company" t-esc="company.name"/>
                </div>

                <div class="o_my_home_menu_search">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <input t-ref="search" type="text" placeholder="Search apps..." aria-label="Search apps"
                           autocomplete="off" t-att-value="state.query"
                           t-on-input="onSearchInput" t-on-keydown="onSearchKeydown"/>
                </div>

                <div class="o_my_home_menu_grid" t-if="visibleApps.length">
                    <a t-foreach="visibleApps" t-as="app" t-key="app.id"
                       class="o_my_home_menu_app"
                       t-att-class="{ o_focused: state.query and app_index === state.focusedIndex }"
                       t-att-href="app.href"
                       t-att-data-menu-xmlid="app.xmlid"
                       t-att-style="'animation-delay: ' + (app_index * 25) + 'ms'"
                       t-on-click="(ev) => this.onAppClick(ev, app)">
                        <img t-if="app.webIconData" class="o_my_home_menu_icon" t-att-src="app.webIconData" alt=""/>
                        <div t-else="" class="o_my_home_menu_icon d-flex align-items-center justify-content-center"
                             t-attf-style="background-color: {{app.webIcon.backgroundColor}};">
                            <i t-att-class="app.webIcon.iconClass" t-attf-style="color: {{app.webIcon.color}};"/>
                        </div>
                        <span class="o_my_home_menu_caption" t-esc="app.name"/>
                    </a>
                </div>
                <div t-else="" class="o_my_home_menu_empty">
                    No app matches "<t t-esc="state.query"/>".
                </div>
            </div>
        </div>
    </t>

</templates>
