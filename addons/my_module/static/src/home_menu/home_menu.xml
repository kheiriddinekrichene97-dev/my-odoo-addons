<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="my_module.HomeMenu">
        <div class="o_action o_my_home_menu h-100 overflow-auto">
            <div class="o_my_home_menu_grid" t-if="apps.length">
                <a t-foreach="apps" t-as="app" t-key="app.id"
                   class="o_my_home_menu_app"
                   t-att-href="app.href"
                   t-att-data-menu-xmlid="app.xmlid"
                   t-on-click="(ev) => this.onAppClick(ev, app)">
                    <img t-if="app.webIconData" class="o_my_home_menu_icon" t-att-src="app.webIconData" alt=""/>
                    <div t-else="" class="o_my_home_menu_icon d-flex align-items-center justify-content-center"
                         t-attf-style="background-color: {{app.webIcon.backgroundColor}};">
                        <i t-att-class="app.webIcon.iconClass" t-attf-style="color: {{app.webIcon.color}};"/>
                    </div>
                    <span class="o_my_home_menu_caption" t-esc="app.name"/>
                </a>
            </div>
            <div t-else="" class="text-center text-muted p-5">
                No apps available.
            </div>
        </div>
    </t>

</templates>
