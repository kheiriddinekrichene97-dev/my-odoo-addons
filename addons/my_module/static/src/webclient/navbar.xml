<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.ui.isSmall']" position="before">
            <!-- Small screens already have Odoo's own side menu -->
            <SideMenu t-if="!isScopedApp and !this.ui.isSmall"/>
            <!-- Back to the home page: pointless while already on it -->
            <a t-if="!isScopedApp and !isHomeMenuActive" href="/odoo/home" class="o_my_home_button"
               title="Home" aria-label="Home" t-on-click.prevent="onHomeButtonClick">
                <i class="fa fa-home"/>
            </a>
        </xpath>
        <!-- The sidebar replaces the apps dropdown (it lists Home and every app) -->
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
    </t>

</templates>
