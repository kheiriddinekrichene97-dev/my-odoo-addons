<odoo>
    <record id="view_partner_form_bonus_points" model="ir.ui.view">
        <field name="name">res.partner.form.bonus.points</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(bonus_point_batch_action)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-star"
                        context="{'search_default_partner_id': id}">
                    <field name="bonus_points_available" widget="statinfo" string="Bonus Points"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
