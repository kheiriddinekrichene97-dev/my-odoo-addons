<odoo>
    <record id="bonus_point_movement_view_list" model="ir.ui.view">
        <field name="name">bonus.point.movement.list</field>
        <field name="model">bonus.point.movement</field>
        <field name="arch" type="xml">
            <list string="Bonus Points Movements" default_order="date desc">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="movement_type"/>
                <field name="points"/>
                <field name="batch_id"/>
                <field name="pos_order_id"/>
                <field name="pos_order_line_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="bonus_point_movement_action" model="ir.actions.act_window">
        <field name="name">Bonus Points Movements</field>
        <field name="res_model">bonus.point.movement</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
