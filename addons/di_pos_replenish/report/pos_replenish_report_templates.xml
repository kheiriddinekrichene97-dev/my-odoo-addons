<odoo>

    <template id="report_pos_replenish_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Every heading comes from the field it prints. Free text in
                     a QWeb template is a view term, and those do not reach a
                     custom module's catalogue on every database, so the sheet
                     would print English beside an Italian screen. -->
                <t t-set="labels" t-value="doc.report_labels()"/>
                <t t-set="sections" t-value="doc.report_lines()"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2>
                            <span t-field="doc.name"/>
                            <span t-if="doc.state != 'confirmed'"
                                  class="badge text-bg-secondary ms-2"
                                  t-esc="labels['state']"/>
                        </h2>

                        <div class="row mt-3 mb-4">
                            <div class="col-3">
                                <strong t-esc="labels['date_from']"/>
                                <div t-field="doc.date_from"/>
                            </div>
                            <div class="col-3">
                                <strong t-esc="labels['date_to']"/>
                                <div t-field="doc.date_to"/>
                            </div>
                            <div class="col-3">
                                <strong t-esc="labels['net']"/>
                                <div t-field="doc.total_sold"/>
                            </div>
                            <div class="col-3">
                                <strong t-esc="labels['to_send']"/>
                                <div t-field="doc.total_to_send"/>
                            </div>
                        </div>

                        <!-- One block per point of sale, each starting on its
                             own page: the sheets are split up and handed to a
                             different picker per shop. -->
                        <t t-foreach="sections" t-as="section">
                            <div t-attf-class="#{'mt-4' if section_first else 'mt-4 o_page_break'}">
                                <h4>
                                    <span t-esc="section['config'].name"/>
                                    <small class="text-muted ms-2"
                                           t-esc="section['config'].warehouse_id.display_name"/>
                                </h4>

                                <t t-foreach="section['groups']" t-as="group">
                                    <h5 class="mt-3">
                                        <span t-esc="group['root']"/>
                                        <span class="mx-1">/</span>
                                        <span t-esc="group['position']"/>
                                        <t t-if="group['category']">
                                            <span class="mx-1">/</span>
                                            <span t-esc="group['category']"/>
                                        </t>
                                    </h5>
                                    <table class="table table-sm o_main_table">
                                        <thead>
                                            <tr>
                                                <th t-esc="labels['product']"/>
                                                <th t-esc="labels['code']"/>
                                                <th t-esc="labels['barcode']"/>
                                                <th t-esc="labels['season']"/>
                                                <th class="text-end" t-esc="labels['net']"/>
                                                <th class="text-end" t-esc="labels['to_send']"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="group['lines']" t-as="line">
                                                <td><span t-field="line.product_id"/></td>
                                                <td><span t-field="line.default_code"/></td>
                                                <td><span t-field="line.barcode"/></td>
                                                <td><span t-esc="line.season_name"/></td>
                                                <td class="text-end">
                                                    <span t-field="line.net_sold_qty"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-field="line.qty_to_send"/>
                                                    <!-- The row a picker has to
                                                         be told about: the shop
                                                         stays short. -->
                                                    <span t-if="line.shortfall"
                                                          class="ms-1 badge text-bg-warning"
                                                          t-esc="'-%g' % line.shortfall"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>

                                <div class="row">
                                    <div class="col-6 offset-6 text-end">
                                        <strong t-esc="labels['to_send']"/>
                                        <span class="ms-2" t-esc="'%g' % section['to_send']"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
