msgstr "Quantità ricevuta non valida per la riga %r."

#. module: di_stock_arrival
#. odoo-python
#: code:addons/di_stock_arrival/models/stock_arrival.py:0
msgid "A received quantity cannot be negative (%(product)s)."
msgstr "Una quantità ricevuta non può essere negativa (%(product)s)."

#. module: di_stock_arrival
#. odoo-javascript
#: code:addons/di_stock_arrival/static/src/distribution_matrix/distribution_matrix.js:0
msgid "Quantity copied down that destination."
msgstr "Quantità copiata su tutta quella destinazione."

#. module: di_stock_arrival
#. odoo-javascript
#: code:addons/di_stock_arrival/static/src/distribution_matrix/distribution_matrix.js:0
