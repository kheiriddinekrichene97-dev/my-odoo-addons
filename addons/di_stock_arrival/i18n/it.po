msgstr "Destinazione svuotata."

#. module: di_stock_arrival
#. odoo-javascript
#: code:addons/di_stock_arrival/static/src/distribution_matrix/distribution_matrix.xml:0
msgid "Write a quantity here and press Enter to put it on this destination for every product listed."
msgstr "Scrivi qui una quantità e premi Invio per metterla su questa destinazione per ogni prodotto elencato."

