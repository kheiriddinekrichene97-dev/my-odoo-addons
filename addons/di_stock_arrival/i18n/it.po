msgstr "La distribuzione di questo arrivo non può più essere modificata."

#. module: di_stock_arrival
#. odoo-python
#: code:addons/di_stock_arrival/models/stock_arrival.py:0
msgid "Only a draft arrival can be confirmed."
msgstr "Solo un arrivo in bozza può essere confermato."

#. module: di_stock_arrival
#. odoo-python
#: code:addons/di_stock_arrival/models/stock_arrival.py:0
