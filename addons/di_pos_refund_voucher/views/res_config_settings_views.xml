<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_di_voucher" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.di.refund.voucher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting string="Rimborso con Buono"
                         help="How long a gift card issued for a refund stays spendable.">
                    <div class="content-group mt-2">
                        <div class="row">
                            <label for="di_voucher_validity_months" class="col-lg-6 o_light_label"/>
                            <field name="di_voucher_validity_months"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
